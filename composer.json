{
  "name": "stuttter/wp-user-profiles",
  "description": "A sophisticated way to edit users in WordPress",
  "homepage": "https://github.com/stuttter/wp-user-profiles",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=7.4",
    "composer/installers": "^2.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6.36",
    "wp-cli/i18n-command": "2.7.0",
    "wp-cli/wp-cli": "2.12.0"
  },
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "John James Jacoby",
      "email": "johnjamesjacoby@me.com"
    }
  ],
  "scripts": {
    "i18n": "bash bin/i18n.sh",
    "i18n:check": "bash bin/i18n.sh --check",
    "release:check": "php bin/check-release-metadata.php",
    "release:version": "php bin/update-version.php",
    "test": [
      "phpunit",
      "@release:check",
      "@i18n:check"
    ]
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true
    },
    "platform": {
      "php": "7.4.0"
    },
    "sort-packages": true
  }
}
